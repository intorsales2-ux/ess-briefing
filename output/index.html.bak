.sel-count{background:rgba(0,0,0,.25);border-radius:12px;padding:.12rem .5rem;font-size:11px}
.cmt-wrap{margin-top:8px}
.cmt-item{background:#0b131b;border:1px solid #1f2a36;border-radius:10px;padding:10px 13px;margin-bottom:8px;font-size:13px;line-height:1.65}
.cmt-item b{color:#4dd0a4;font-size:12px;margin-right:7px}
.cmt-item .t{color:#6b7684;font-size:10.5px;margin-left:7px}
.cmt-item .ops{float:right}
.cmt-item .ops button{background:transparent;color:#6b7684;border:none;cursor:pointer;font-size:11px;font-family:inherit;padding:0 4px}
.cmt-item .ops button:hover{color:#e6edf3}
.cmt-empty{color:#6b7684;font-size:12.5px;margin:6px 0 10px}
.cmt-form{display:grid;grid-template-columns:150px 150px 1fr auto;gap:7px;margin-top:6px}
.cmt-form input,.cmt-form textarea{background:#0b131b;color:#e6edf3;border:1px solid #2a3644;border-radius:8px;padding:8px 10px;font-size:12.5px;font-family:inherit}
.cmt-form textarea{height:38px;resize:vertical}
.cmt-form button{background:#4dd0a4;color:#07130d;border:none;border-radius:8px;padding:8px 16px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit}
.cmt-note{grid-column:1/-1;color:#6b7684;font-size:10.5px}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
@media(max-width:760px){.cmt-form{grid-template-columns:1fr 1fr}.cmt-form textarea,.cmt-form button,.cmt-note{grid-column:1/-1}}
</style>

<div class="float-btn" id="floatBtn">
  <button class="report-btn" id="btnReport">📄 선택 기사 보고서 <span class="sel-count" id="selCount">0</span></button>
</div>

<script>
(function(){
  var sel = new Set(), seq = 0;
  var cards = document.querySelectorAll('article.card');
  cards.forEach(function(c){
    var id = 'a' + (seq++); c.dataset.rid = id;
    var h = c.querySelector('h3'); if (!h) return;
    var cb = document.createElement('input');
    cb.type='checkbox'; cb.className='art-check'; cb.title='보고서에 담기';
    h.insertBefore(cb, h.firstChild);
    var link = cb.closest('a');
    if (link) link.addEventListener('click', function(e){
      if (e.target.classList && e.target.classList.contains('art-check')) e.preventDefault();
    });
    cb.addEventListener('click', function(e){ e.stopPropagation(); });
    cb.addEventListener('change', function(){
      this.checked ? sel.add(id) : sel.delete(id);
      c.classList.toggle('picked', this.checked);
      document.getElementById('selCount').textContent = sel.size;
      document.getElementById('floatBtn').classList.toggle('visible', sel.size > 0);
    });
  });
  function txt(el){ return el ? el.textContent.replace(/\u2197/g,'').trim() : ''; }
  function issueLine(){
    var b = document.querySelector('.issue b'); var d = document.querySelector('.issue');
    var date = d ? (d.innerHTML.split('<br>')[1]||'').replace(/<[^>]+>/g,'').trim() : '';
    return (b ? txt(b) : '') + (date ? ' · ' + date : '');
  }
  document.getElementById('btnReport').addEventListener('click', function(){
    var ps = Array.prototype.filter.call(cards, function(c){ return sel.has(c.dataset.rid); });
    if (!ps.length) { alert('기사를 먼저 선택해주세요.'); return; }
    var logo = document.querySelector('img.logo'); var logoSrc = logo ? logo.src : '';
    var now = new Date();
    var body = ps.map(function(c, i){
      var tags = Array.prototype.map.call(c.querySelectorAll('.tags .tag'), txt).join(' · ');
      var a = c.querySelector('a.hl'); var url = a ? a.getAttribute('href') : '';
      var det = c.querySelector('.art-detail');
      var sum = c.querySelector('.summary'); var ins = c.querySelector('.insight');
      var src = c.querySelector('.src'); var val = c.querySelector('.impact .val');
      var main;
      if (det) {
        main = '<div style="font-size:13px;color:#222;line-height:1.85;">' + det.innerHTML + '</div>';
      } else {
        main = (sum ? '<ul style="font-size:12.8px;color:#222;line-height:1.75;margin:0 0 10px 18px;padding:0;">' + sum.innerHTML + '</ul>' : '');
      }
      return '<div style="margin-bottom:32px;padding-bottom:28px;border-bottom:1px solid #e6e6e6;page-break-inside:avoid;">'
        + '<div style="font-size:11px;font-weight:700;color:#8a6d1d;letter-spacing:.05em;margin-bottom:7px;">' + tags + (val ? ' <span style="color:#888;">| ' + txt(val) + '</span>' : '') + '</div>'
        + '<h3 style="font-size:17px;font-weight:700;color:#111;line-height:1.5;margin:0 0 8px;">' + String(i+1).padStart(2,'0') + '.&nbsp; ' + txt(c.querySelector('h3')) + '</h3>'
        + (url ? '<div style="font-size:10.5px;color:#888;margin-bottom:12px;">🔗 원문: <a href="' + url + '" style="color:#8a6d1d;word-break:break-all;">' + url + '</a></div>' : '')
        + main
        + (ins ? '<div style="font-size:12.5px;color:#222;line-height:1.7;background:#f7f5ef;padding:12px 14px;border-radius:6px;border-left:4px solid #c9a02a;margin-top:12px;">' + ins.innerHTML + '</div>' : '')
        + (src ? '<div style="font-size:10.5px;color:#777;margin-top:9px;">' + src.innerHTML + '</div>' : '')
        + '</div>';
    }).join('');
    var toc = ps.map(function(c){ return '<li>' + txt(c.querySelector('h3')) + '</li>'; }).join('');
    var w = window.open('', '_blank', 'width=980,height=820');
    if (!w) { alert('팝업이 차단됐습니다. 주소창의 팝업 허용을 눌러주세요.'); return; }
    w.document.write('<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>인투알 ESS 브리핑 — 선택 기사 상세 보고서</title>'
      + '<style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:"Malgun Gothic","Apple SD Gothic Neo",sans-serif;font-size:13px;color:#111;background:#fff;padding:44px;max-width:860px;margin:0 auto}a{color:#8a6d1d}p{margin:0 0 11px}.no-print{margin-bottom:22px;display:flex;gap:10px}@media print{.no-print{display:none!important}body{padding:20px}}</style></head><body>'
      + '<div class="no-print"><button onclick="window.print()" style="background:#0e1720;color:#fff;border:none;padding:10px 24px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;">🖨️ 인쇄 / PDF 저장</button>'
      + '<button onclick="window.close()" style="background:#eee;color:#333;border:none;padding:10px 18px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:13px;">✕ 닫기</button></div>'
      + '<div style="display:flex;align-items:center;gap:14px;background:#0e1720;border-radius:10px;padding:16px 20px;margin-bottom:12px;">'
      + (logoSrc ? '<img src="' + logoSrc + '" style="height:40px;">' : '')
      + '<div><div style="font-size:21px;font-weight:900;color:#fff;">선택 기사 상세 보고서</div>'
      + '<div style="font-size:11px;color:#9aa4b2;margin-top:3px;">' + issueLine() + ' · 출력 ' + now.toLocaleString('ko-KR') + ' · 선택 ' + ps.length + '건 · © 인투알 영업팀, 내부용</div></div></div>'
      + '<ol style="font-size:11.5px;color:#444;margin:0 0 26px 18px;">' + toc + '</ol>'
      + body
      + '<div style="font-size:10px;color:#999;border-top:1px solid #ddd;padding-top:10px;">본 보고서의 상세 본문은 에디터가 원문 기사·공시를 바탕으로 작성한 해설이며, 원문 전문의 복제가 아닙니다. 정확한 사실 확인은 각 기사의 원문 링크를 이용해 주세요.</div>'
      + '</body></html>');
    w.document.close();
  });

  // ── 하단 댓글 (이름 · 비밀번호 — 우체통 연결 시 표시) ──
  var API = '';
  var root = document.getElementById('cmt-root');
  if (!root) return;
  if (!API) {
    document.getElementById('cmt-list').innerHTML =
      '<div class="cmt-empty">🔌 댓글 우체통(구글 시트)이 아직 연결되지 않았습니다 — 관리자가 연결하는 즉시 이 자리에서 등록 · 수정 · 삭제가 바로 작동합니다.</div>';
    document.getElementById('cmt-submit').addEventListener('click', function(){
      alert('댓글 우체통이 아직 연결되지 않았습니다.\n(관리자: comments-setup-guide의 우체통 URL 연결 후 재발행하면 작동합니다)');
    });
    return;
  }
  var issueEl = document.querySelector('.issue b'); var ISSUE = issueEl ? issueEl.textContent.trim() : 'unknown';
  function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML;}
  function jp(params, cb){
    var name = '__cb' + Math.floor(Math.random()*1e9);
    window[name] = function(res){ cb(res); delete window[name]; s.remove(); };
    var q = Object.keys(params).map(function(k){return k+'='+encodeURIComponent(params[k]);}).join('&');
    var s = document.createElement('script');
    s.src = API + (API.indexOf('?')>0?'&':'?') + q + '&callback=' + name + '&_=' + Date.now();
    s.onerror = function(){ cb({ok:false, error:'network'}); delete window[name]; s.remove(); };
    document.body.appendChild(s);
  }
  function draw(rows){
    var list = document.getElementById('cmt-list');
    if (!rows || !rows.length) { list.innerHTML = '<div class="cmt-empty">첫 댓글을 남겨보세요 — 이름과 비밀번호(수정·삭제용)만 있으면 됩니다.</div>'; return; }
    list.innerHTML = rows.map(function(r){
      return '<div class="cmt-item" data-id="'+esc(r.id)+'"><span class="ops"><button class="op-e">수정</button><button class="op-d">삭제</button></span><b>'+esc(r.name||'익명')+'</b>'+esc(r.text)+'<span class="t">'+esc(r.time||'')+'</span></div>';
    }).join('');
    list.querySelectorAll('.op-d').forEach(function(b){
      b.addEventListener('click', function(){
        var id = this.closest('.cmt-item').dataset.id;
        var pw = prompt('이 댓글의 비밀번호를 입력하세요 (삭제)'); if (pw === null || !pw) return;
        jp({mode:'del', issue:ISSUE, id:id, pw:pw}, function(res){
          if (res && res.ok) refresh(); else alert(res && res.error === 'pw' ? '비밀번호가 일치하지 않습니다.' : '삭제에 실패했습니다.');
        });
      });
    });
    list.querySelectorAll('.op-e').forEach(function(b){
      b.addEventListener('click', function(){
        var item = this.closest('.cmt-item'); var id = item.dataset.id;
        var pw = prompt('이 댓글의 비밀번호를 입력하세요 (수정)'); if (pw === null || !pw) return;
        var cur = item.childNodes[2] ? item.childNodes[2].textContent : '';
        var nt = prompt('수정할 내용을 입력하세요', cur); if (nt === null || !nt.trim()) return;
        jp({mode:'edit', issue:ISSUE, id:id, pw:pw, text:nt.trim().slice(0,500)}, function(res){
          if (res && res.ok) refresh(); else alert(res && res.error === 'pw' ? '비밀번호가 일치하지 않습니다.' : '수정에 실패했습니다.');
        });
      });
    });
  }
  function refresh(){ jp({mode:'list', issue:ISSUE}, function(res){ draw(res && res.rows ? res.rows : []); }); }
  document.getElementById('cmt-submit').addEventListener('click', function(){
    var n = document.getElementById('cmt-name').value.trim() || '익명';
    var p = document.getElementById('cmt-pw').value;
    var t = document.getElementById('cmt-text').value.trim();
    var hp = document.getElementById('cmt-hp').value;
    if (!t) { alert('내용을 입력해주세요.'); return; }
    if (!p || p.length < 4) { alert('비밀번호를 4자 이상 입력해주세요 (수정·삭제에 사용됩니다).'); return; }
    jp({mode:'add', issue:ISSUE, name:n.slice(0,20), pw:p, text:t.slice(0,500), hp:hp}, function(res){
      if (res && res.ok) { document.getElementById('cmt-text').value=''; document.getElementById('cmt-pw').value=''; refresh(); }
      else alert('등록에 실패했습니다. 잠시 후 다시 시도해주세요.');
    });
  });
  refresh();
})();
</script>
</body>
</html>